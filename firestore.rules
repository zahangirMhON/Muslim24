rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User activity logs and progress check marks
    match /userActivities/{activityId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User customized 24/7 radio schedule and playlist items
    match /userSchedules/{scheduleId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
